# Configuration Strava OAuth
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
STRAVA_REDIRECT_URI=http://localhost:3000/inscription.html
# Identifiant de l'abonnement aux webhooks Strava (admin > Statut Strava).
# Recommandé : les événements d'un autre abonnement sont alors ignorés.
STRAVA_SUBSCRIPTION_ID=

# Configuration serveur
PORT=3000
NODE_ENV=development

# Configuration base de données (optionnel - actuellement on utilise JSON)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=versant
# DB_USER=versant
# DB_PASSWORD=your_password

# Configuration sécurité
# Mot de passe de l'admin. Obligatoire : sans lui, toutes les routes admin
# sont refusées (il n'y a plus de valeur par défaut).
ADMIN_PASSWORD=
# Super-admins (L43) : e-mails des comptes joueurs qui ont tous les droits
# d'administration, séparés par des virgules. Le mot de passe admin ci-dessus
# reste un accès de secours.
SUPER_ADMIN_EMAILS=
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# Configuration synchronisation
SYNC_CRON_SCHEDULE=0 6 * * *
SYNC_DAYS_LOOKBACK=7

# E-mails (L57) : Brevo, menu SMTP et API > onglet SMTP. SMTP_USER est
# l'identifiant affiché par Brevo (xxx@smtp-brevo.com), SMTP_PASS la clé SMTP.
# Test : node backend/scripts/send-test-mail.js ton@adresse.fr
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Versant-app <noreply@versant-app.fr>"
# Adresse du site, pour les liens envoyés par e-mail (mot de passe oublié)
PUBLIC_URL=https://versant-app.fr

# Bac à sable du harnais de non-régression (backend/scripts/regression)
# NE JAMAIS DÉFINIR EN PRODUCTION
# VERSANT_DATA_DIR=/chemin/vers/une/copie/des/donnees
# VERSANT_DISABLE_JOBS=1
# STRAVA_API_BASE=http://127.0.0.1:9
# OPEN_METEO_URL=http://127.0.0.1:9
